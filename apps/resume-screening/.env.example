# LLM provider: ark (default, Volcengine Coding Plan) | anthropic
LLM_PROVIDER=ark

# --- Volcengine Ark (default provider) ---
# 必须用 Coding Plan 端点 /api/coding/v1，/api/v3 会走普通计费
VOLCENGINE_API_KEYwinomp=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1
# EXTRACT_MODEL=ark-code-latest
# SCORE_MODEL=ark-code-latest

# --- Anthropic (alternative provider) ---
# ANTHROPIC_API_KEY=
# EXTRACT_MODEL=claude-sonnet-4-5
# SCORE_MODEL=claude-opus-4-5

# Optional: override SQLite db path (defaults to ./data.db)
# DB_PATH=./data.db
