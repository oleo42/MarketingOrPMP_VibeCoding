# 语料路径（相对 support-assistant 根）
# CORPUS_PATH=./data/corpus.jsonl

# LLM provider: deepseek | openai | ark
# 新增 provider：在 src/llm/providers.ts 的 getProvider() 加分支（OpenAI 兼容端点均可接入）
LLM_PROVIDER=deepseek

# --- DeepSeek (推荐，便宜且中文好) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI ChatGPT ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Volcengine Ark ---
# VOLCENGINE_API_KEYwinomp=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1
# ARK_MODEL=ark-code-latest